# Protect database and sensitive files
<FilesMatch "\.(sqlite|sqlite3|db|log|env)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# Enable directory index
DirectoryIndex index.php index.html

# Prevent directory listing
Options -Indexes

# SEO Friendly URL Rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Dynamic Sitemap
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # 2. Chi tiết sản phẩm chuẩn SEO: /san-pham/serum-b5...
    RewriteRule ^san-pham/([a-zA-Z0-9_-]+)/?$ product.php?slug=$1 [L,QSA]

    # 3. Trang danh mục sản phẩm: /danh-muc/chong-nang...
    RewriteRule ^danh-muc/([a-zA-Z0-9_-]+)/?$ index.php?category=$1 [L,QSA]
</IfModule>
